    User "1" --> "*" Task : has
    User "1" --> "*" Pet : has
    User "1" --> "*" Schedule : has
    Task "*" --> "*" Pet : involves
    Schedule "1" *-- "*" ScheduledTask : placements
    ScheduledTask "*" --> "1" Task : wraps
    Schedule "1" ..> "*" Task : unscheduled, not due, conflicts
    helpers ..> Task : filters
    helpers ..> ScheduledTask : filters
    helpers ..> Pet : by
